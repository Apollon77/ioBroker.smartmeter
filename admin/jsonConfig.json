      "type": "number",
      "label": "field_transportSerialMessageTimeout",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "min": 1,
      "hidden": "data.transport !== 'SerialRequestResponseTransport' && data.transport !== 'SerialResponseTransport'",
      "unit": "s",
      "help": "info_transportSerialMessageTimeout"

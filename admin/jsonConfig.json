      "type": "text",
      "label": "field_protocolD0DeviceAddress",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.protocol !== 'D0Protocol'",
      "help": "info_protocolD0DeviceAddress"
    },
    "protocolD0SignOnMessage": {
      "type": "text",
      "label": "field_protocolD0SignOnMessage",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.protocol !== 'D0Protocol'",
      "help": "info_protocolD0SignOnMessage"
    },
    "protocolD0ModeOverwrite": {
      "type": "select",
      "label": "field_protocolD0ModeOverwrite",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.protocol !== 'D0Protocol'",
      "options": [
        {
          "label": "value_no_overwrite",
          "value": ""
        },
        {
          "label": "A",
          "value": "A"
        },
        {
          "label": "B",
          "value": "B"
        },
        {
          "label": "C",
          "value": "C"
        },
        {
          "label": "D",
          "value": "D"
        },
        {
          "label": "E",
          "value": "E"
        }
      ],
      "help": "info_protocolD0ModeOverwrite"
    },
    "protocolD0BaudrateChangeoverOverwrite": {
      "type": "number",
      "label": "field_protocolD0BaudrateChangeoverOverwrite",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "min": 300,
      "unit": "baud",
      "hidden": "data.protocol !== 'D0Protocol'",
      "help": "info_protocolD0BaudrateChangeoverOverwrite"
    },
    "anotherQueryDelay": {
      "type": "number",
      "label": "field_anotherQueryDelay",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "min": 0,
      "unit": "ms",
      "hidden": "data.protocol !== 'D0Protocol'",
      "help": "info_anotherQueryDelay"
    },
    "protocolSmlIgnoreInvalidCRC": {
      "type": "checkbox",
      "label": "field_protocolSmlIgnoreInvalidCRC",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.protocol !== 'SmlProtocol'"

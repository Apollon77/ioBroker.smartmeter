      "type": "text",
      "label": "field_transportHttpRequestUrl",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.transport !== 'HttpRequestTransport'"
    },
    "transportHttpRequestTimeout": {
      "type": "number",
      "label": "field_transportHttpRequestTimeout",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "min": 500,
      "unit": "ms",
      "hidden": "data.transport !== 'HttpRequestTransport'",
      "help": "info_transportHttpRequestTimeout"
    },
    "transportLocalFilePath": {
      "type": "text",
      "label": "field_transportLocalFilePath",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.transport !== 'LocalFileTransport'"
    },
    "transportTcpHost": {
      "type": "text",
      "label": "field_transportTcpHost",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.transport !== 'TCPTransport'"
    },
    "transportTcpPort": {
      "type": "number",
      "label": "field_transportTcpPort",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "min": 1,
      "max": 65535,
      "hidden": "data.transport !== 'TCPTransport'"

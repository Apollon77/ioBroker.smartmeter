{
  "type": "panel",
  "i18n": true,
  "items": {
    "_general": {
      "type": "header",
      "text": "heading_GeneralSettings",
      "size": 3,
      "newLine": true
    },
    "requestInterval": {
      "type": "number",
      "label": "field_requestInterval",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "min": 0,
      "help": "info_requestInterval"
    },
    "transport": {
      "type": "select",
      "label": "field_transport",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "options": [
        {
          "label": "value_transport_HttpRequestTransport",
          "value": "HttpRequestTransport"
        },
        {
          "label": "value_transport_LocalFileTransport",
          "value": "LocalFileTransport"
        },
        {
          "label": "value_transport_SerialRequestResponseTransport",
          "value": "SerialRequestResponseTransport"
        },
        {
          "label": "value_transport_SerialResponseTransport",
          "value": "SerialResponseTransport"
        },
        {
          "label": "value_transport_TCPTransport",
          "value": "TCPTransport"
        }
      ]
    },
    "protocol": {
      "type": "select",
      "label": "field_protocol",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "options": [
        {
          "label": "value_protocol_D0Protocol",
          "value": "D0Protocol"
        },
        {
          "label": "value_protocol_JsonEfrProtocol",
          "value": "JsonEfrProtocol"
        },
        {
          "label": "value_protocol_SmlProtocol",
          "value": "SmlProtocol"
        }
      ]
    },
    "obisNameLanguage": {
      "type": "select",
      "label": "field_obisNameLanguage",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "options": [
        {
          "label": "value_obisNameLanguage_de",
          "value": "de"
        },
        {
          "label": "value_obisNameLanguage_en",
          "value": "en"
        }
      ]

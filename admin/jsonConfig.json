      "type": "header",
      "text": "heading_TransportSpecificSettings",
      "size": 3,
      "newLine": true
    },
    "transportSerialPort": {
      "type": "selectSendTo",
      "label": "field_transportSerialPort",
      "command": "listUartOptions",
      "manual": true,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.transport !== 'SerialRequestResponseTransport' && data.transport !== 'SerialResponseTransport'"
    },
    "customSerialPort": {
      "type": "text",
      "label": "field_customSerialPort",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "(data.transport !== 'SerialRequestResponseTransport' && data.transport !== 'SerialResponseTransport') || data.transportSerialPort !== '-'"

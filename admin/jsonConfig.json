      "label": "field_obisFallbackMedium",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.protocol !== 'D0Protocol'",
      "options": [
        {
          "label": "value_obisFallbackMedium_0",
          "value": "0"
        },
        {
          "label": "value_obisFallbackMedium_1",
          "value": "1"
        },
        {
          "label": "value_obisFallbackMedium_4",
          "value": "4"
        },
        {
          "label": "value_obisFallbackMedium_5",
          "value": "5"
        },
        {
          "label": "value_obisFallbackMedium_6",
          "value": "6"
        },
        {
          "label": "value_obisFallbackMedium_7",
          "value": "7"
        },
        {
          "label": "value_obisFallbackMedium_8",
          "value": "8"
        },
        {
          "label": "value_obisFallbackMedium_9",
          "value": "9"

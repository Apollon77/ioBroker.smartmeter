        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ],
      "help": "info_transportSerialStopBits"
    },
    "transportSerialParity": {
      "type": "select",
      "label": "field_transportSerialParity",
      "sm": 12,
      "md": 6,
      "lg": 4,
      "hidden": "data.transport !== 'SerialRequestResponseTransport' && data.transport !== 'SerialResponseTransport'",
      "options": [
        {
          "label": "value_protocol_default",
          "value": ""
        },
        {
          "label": "none",
          "value": "none"
        },
        {
          "label": "even",
          "value": "even"
        },
        {
          "label": "mark",
          "value": "mark"
        },
        {
          "label": "odd",
          "value": "odd"
        },
        {
          "label": "space",
          "value": "space"
        }
      ],
      "help": "info_transportSerialParity"
    },
